---
// Replays /joint_states recorded from my Project 2 runtime (scripts/record_p2.py).
// The page simulates nothing: it turns each published set of joint angles into
// link positions (the arm's forward kinematics) and blends neighbouring frames.
import { url } from "../lib/url";

interface Props {
  recording: string; // JSON from scripts/record_p2.py
  label: string; // accessible description of what plays
}
const { recording, label } = Astro.props;
---

<figure class="pendularm" data-recording={url(recording)}>
  <div class="stage">
    <canvas class="arm" role="img" aria-label={label}></canvas>
    <div class="status" aria-live="polite">Loading the recording…</div>
    <div class="phase" aria-hidden="true"></div>
  </div>
  <div class="plot-wrap">
    <canvas class="plot" aria-hidden="true"></canvas>
    <ul class="legend" aria-hidden="true"></ul>
  </div>
  <div class="bar">
    <button class="play" type="button" aria-label="Pause">❚❚</button>
    <input class="scrub" type="range" min="0" max="1000" value="0" aria-label="Position in the recording" />
    <span class="time">0.0 s</span>
    <button class="speed" type="button" aria-label="Playback speed">1×</button>
  </div>
</figure>

<script>
  type Event =
    | { t: number; kind: "free" }
    | { t: number; kind: "goal"; x: number; y: number; phi: number }
    | { t: number; kind: "result"; outcome: string; distance: number };
  type Recording = { links: number; lengths: number[]; duration: number; events: Event[]; frames: number[][] };

  const COLORS = ["#ffcb05", "#5cc8ff", "#ff7b72"];
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  function setup(figure: HTMLElement, rec: Recording) {
    const n = rec.links;
    const armCanvas = figure.querySelector<HTMLCanvasElement>(".arm")!;
    const plotCanvas = figure.querySelector<HTMLCanvasElement>(".plot")!;
    const phase = figure.querySelector<HTMLElement>(".phase")!;
    const play = figure.querySelector<HTMLButtonElement>(".play")!;
    const scrub = figure.querySelector<HTMLInputElement>(".scrub")!;
    const time = figure.querySelector<HTMLElement>(".time")!;
    const speedButton = figure.querySelector<HTMLButtonElement>(".speed")!;
    const reach = rec.lengths.reduce((a, b) => a + b, 0);
    const frames = rec.frames;
    const goals = rec.events.filter((e) => e.kind === "goal");

    figure.querySelector(".legend")!.innerHTML = rec.lengths
      .map((_, i) => `<li><i style="background:${COLORS[i]}"></i>q${i + 1}</li>`)
      .join("") + `<li><i class="dash"></i>setpoint</li>`;

    // Frame at time t: blend the two published frames around it.
    const sample = (t: number) => {
      let lo = 0;
      let hi = frames.length - 1;
      while (hi - lo > 1) {
        const mid = (lo + hi) >> 1;
        if (frames[mid][0] <= t) lo = mid;
        else hi = mid;
      }
      const a = frames[lo];
      const b = frames[hi];
      const k = b[0] > a[0] ? Math.min(1, Math.max(0, (t - a[0]) / (b[0] - a[0]))) : 0;
      return a.map((v, i) => v + (b[i] - v) * k);
    };
    const joints = (q: number[]) => {
      const points: [number, number][] = [[0, 0]];
      let heading = 0;
      for (let i = 0; i < n; i++) {
        heading += q[i];
        const [x, y] = points[i];
        points.push([x + rec.lengths[i] * Math.cos(heading), y + rec.lengths[i] * Math.sin(heading)]);
      }
      return points;
    };

    const fit = (canvas: HTMLCanvasElement) => {
      const ratio = Math.min(devicePixelRatio || 1, 2);
      const { width, height } = canvas.getBoundingClientRect();
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      const ctx = canvas.getContext("2d")!;
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      return { ctx, width, height };
    };

    let plotImage: { ctx: CanvasRenderingContext2D; width: number; height: number; image: ImageData } | null = null;
    const drawPlot = () => {
      const { ctx, width, height } = fit(plotCanvas);
      const pad = 6;
      const values = frames.flatMap((f) => f.slice(1, 1 + 2 * n));
      const min = Math.min(...values);
      const max = Math.max(...values);
      const X = (t: number) => (t / rec.duration) * width;
      const Y = (v: number) => pad + (1 - (v - min) / (max - min)) * (height - 2 * pad);
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = "rgb(255 255 255 / 4%)";
      for (const goal of goals) {
        const end = rec.events.find((e) => e.kind === "result" && e.t > goal.t)?.t ?? rec.duration;
        ctx.fillRect(X(goal.t), 0, X(end) - X(goal.t), height);
      }
      for (let j = 0; j < n; j++) {
        for (const [offset, dashed] of [[1 + n, true], [1, false]] as const) {
          ctx.beginPath();
          ctx.setLineDash(dashed ? [4, 4] : []);
          ctx.strokeStyle = COLORS[j];
          ctx.globalAlpha = dashed ? 0.55 : 1;
          ctx.lineWidth = dashed ? 1 : 1.6;
          frames.forEach((f, i) => (i ? ctx.lineTo : ctx.moveTo).call(ctx, X(f[0]), Y(f[offset + j])));
          ctx.stroke();
        }
      }
      ctx.setLineDash([]);
      ctx.globalAlpha = 1;
      plotImage = { ctx, width, height, image: ctx.getImageData(0, 0, plotCanvas.width, plotCanvas.height) };
    };

    let arm = fit(armCanvas);
    const resize = () => {
      arm = fit(armCanvas);
      drawPlot();
      render();
    };

    let t = 0;
    let playing = !reducedMotion;
    let speed = 1;
    const render = () => {
      const { ctx, width, height } = arm;
      const scale = Math.min(width, height) / (2 * reach + 0.6);
      const cx = width / 2;
      const cy = height / 2;
      const P = ([x, y]: [number, number]) => [cx + x * scale, cy - y * scale] as const;
      ctx.clearRect(0, 0, width, height);

      ctx.strokeStyle = "rgb(255 255 255 / 10%)";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(cx, cy, reach * scale, 0, Math.PI * 2);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(cx - 14, cy + 10);
      ctx.lineTo(cx + 14, cy + 10);
      ctx.stroke();

      const frame = sample(t);
      const q = frame.slice(1, 1 + n);
      const setpoint = frame.slice(1 + n, 1 + 2 * n);
      const goal = [...goals].reverse().find((g) => g.t <= t);
      const active = goal && !rec.events.some((e) => e.kind === "result" && e.t > goal.t && e.t <= t);

      if (goal && goal.kind === "goal") {
        // Commanded pose, dashed, and the target with its orientation.
        ctx.setLineDash([5, 5]);
        ctx.strokeStyle = "rgb(255 255 255 / 35%)";
        ctx.lineWidth = 2;
        ctx.beginPath();
        joints(setpoint).forEach((p, i) => (i ? ctx.lineTo : ctx.moveTo).apply(ctx, P(p)));
        ctx.stroke();
        ctx.setLineDash([]);
        const [gx, gy] = P([goal.x, goal.y]);
        ctx.strokeStyle = active ? "#ffcb05" : "#4cc27a";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(gx, gy, 9, 0, Math.PI * 2);
        ctx.moveTo(gx, gy);
        ctx.lineTo(gx + 20 * Math.cos(goal.phi), gy - 20 * Math.sin(goal.phi));
        ctx.stroke();
      }

      // End-effector trail, the last 1.5 s.
      ctx.beginPath();
      for (let s = Math.max(0, t - 1.5), first = true; s <= t; s += 1 / 30, first = false) {
        const tip = joints(sample(s).slice(1, 1 + n))[n];
        (first ? ctx.moveTo : ctx.lineTo).apply(ctx, P(tip));
      }
      ctx.strokeStyle = "rgb(92 200 255 / 45%)";
      ctx.lineWidth = 1.5;
      ctx.stroke();

      const points = joints(q);
      ctx.lineCap = "round";
      for (let i = 0; i < n; i++) {
        ctx.strokeStyle = COLORS[i];
        ctx.lineWidth = Math.max(5, scale * 0.09);
        ctx.beginPath();
        ctx.moveTo(...P(points[i]));
        ctx.lineTo(...P(points[i + 1]));
        ctx.stroke();
      }
      ctx.fillStyle = "#e7eaf0";
      for (const p of points) {
        ctx.beginPath();
        ctx.arc(...P(p), Math.max(3, scale * 0.035), 0, Math.PI * 2);
        ctx.fill();
      }

      const latest = [...rec.events].reverse().find((e) => e.t <= t);
      const index = goal ? goals.indexOf(goal) + 1 : 0;
      phase.textContent =
        !latest || latest.kind === "free"
          ? "PID off · falling under gravity"
          : latest.kind === "goal"
            ? `Goal ${index}/${goals.length} · (${latest.x}, ${latest.y}) m, φ ${latest.phi}`
            : `Goal ${index}/${goals.length} · ${latest.outcome}, ${(latest.distance * 1000).toFixed(0)} mm off`;

      if (plotImage) {
        const { ctx: p, width: w, height: h, image } = plotImage;
        p.putImageData(image, 0, 0);
        const x = (t / rec.duration) * w;
        p.strokeStyle = "#e7eaf0";
        p.lineWidth = 1;
        p.beginPath();
        p.moveTo(x, 0);
        p.lineTo(x, h);
        p.stroke();
      }
      scrub.value = String(Math.round((t / rec.duration) * 1000));
      time.textContent = `${t.toFixed(1)} s`;
    };

    const setPlaying = (value: boolean) => {
      playing = value;
      play.textContent = playing ? "❚❚" : "▶";
      play.setAttribute("aria-label", playing ? "Pause" : "Play");
    };
    play.addEventListener("click", () => setPlaying(!playing));
    scrub.addEventListener("input", () => {
      t = (Number(scrub.value) / 1000) * rec.duration;
      render();
    });
    speedButton.addEventListener("click", () => {
      speed = speed === 1 ? 2 : speed === 2 ? 0.5 : 1;
      speedButton.textContent = `${speed}×`;
    });
    plotCanvas.addEventListener("click", (event) => {
      const box = plotCanvas.getBoundingClientRect();
      t = ((event.clientX - box.left) / box.width) * rec.duration;
      render();
    });

    let visible = true;
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(figure);
    new ResizeObserver(resize).observe(armCanvas);
    setPlaying(playing);

    let last = performance.now();
    let hold = 0; // pause briefly on the last frame before looping
    const tick = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      if (playing && visible) {
        if (t >= rec.duration) {
          hold += dt;
          if (hold > 1.5) {
            t = 0;
            hold = 0;
          }
        } else t = Math.min(rec.duration, t + dt * speed);
        render();
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  for (const figure of document.querySelectorAll<HTMLElement>(".pendularm")) {
    fetch(figure.dataset.recording!)
      .then((response) => response.json())
      .then((rec: Recording) => {
        figure.querySelector<HTMLElement>(".status")!.hidden = true;
        setup(figure, rec);
      })
      .catch(() => {
        figure.querySelector(".status")!.textContent = "Couldn't load the recording.";
      });
  }
</script>

<style>
  .pendularm {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--stage);
    border: 1px solid var(--line);
    color: #e7eaf0;
  }
  .stage {
    position: relative;
    aspect-ratio: 16 / 10;
    max-height: 64vh;
    width: 100%;
  }
  @media (max-width: 720px) {
    .stage {
      aspect-ratio: 1 / 1;
    }
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .status {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #8d97a8;
    font-size: 0.9rem;
  }
  .status[hidden] {
    display: none;
  }
  .phase {
    position: absolute;
    left: 12px;
    top: 10px;
    right: 12px;
    font: 600 0.78rem/1.3 var(--mono);
    color: #c9d1dd;
    pointer-events: none;
  }
  .plot-wrap {
    position: relative;
    height: 96px;
    border-top: 1px solid #222b38;
  }
  .plot {
    cursor: pointer;
  }
  .legend {
    position: absolute;
    right: 8px;
    top: 6px;
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 4px 6px;
    border-radius: 6px;
    background: rgb(16 21 29 / 85%);
    list-style: none;
    font: 0.72rem/1 var(--mono);
    color: #8d97a8;
    pointer-events: none;
  }
  .legend :global(li) {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .legend :global(i) {
    width: 10px;
    height: 3px;
    border-radius: 2px;
  }
  .legend :global(i.dash) {
    background: repeating-linear-gradient(90deg, #8d97a8 0 3px, transparent 3px 5px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    background: #0b0f15;
    border-top: 1px solid #222b38;
    font-size: 0.85rem;
  }
  .bar button {
    font: 600 0.8rem/1 var(--font);
    color: #e7eaf0;
    background: #1b2330;
    border: 1px solid #2c3646;
    border-radius: 8px;
    padding: 7px 10px;
    cursor: pointer;
    min-height: 32px;
  }
  .bar button:hover {
    border-color: #8d97a8;
  }
  .play {
    width: 40px;
  }
  .scrub {
    flex: 1 1 120px;
    min-width: 0;
    accent-color: #ffcb05;
  }
  .time {
    font-family: var(--mono);
    color: #8d97a8;
    width: 4.2em;
    text-align: right;
  }
</style>
