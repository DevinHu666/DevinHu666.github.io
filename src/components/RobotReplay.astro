---
// Replays a recording of /xform_world from one of my runtimes in three.js.
// The page does no kinematics: every drawn pose lies between two poses the
// runtime published (position lerp, rotation slerp between neighbours).
import { url } from "../lib/url";

interface Props {
  model: string; // GLB in public/, one node per link, geometry in the link frame
  recording: string; // JSON from scripts/record_p3.py
  label: string; // accessible description of what plays
  compact?: boolean; // hero mode: no control bar
  recordable?: boolean; // offer "Save video" (WebM via MediaRecorder)
}
const { model, recording, label, compact = false, recordable = false } = Astro.props;
---

<figure
  class:list={["replay", { compact }]}
  data-model={url(model)}
  data-recording={url(recording)}
  data-compact={compact ? "1" : undefined}
  data-recordable={recordable ? "1" : undefined}
>
  <div class="stage">
    <canvas role="img" aria-label={label}></canvas>
    <div class="status" aria-live="polite">Loading the robot…</div>
    <div class="move" aria-hidden="true"><span class="beat"></span><span class="move-name"></span></div>
  </div>
  {!compact && (
    <div class="bar">
      <button class="play" type="button" aria-label="Pause">❚❚</button>
      <input class="scrub" type="range" min="0" max="1000" value="0" aria-label="Position in the loop" />
      <span class="time">0.0 s</span>
      <div class="group" role="group" aria-label="Camera">
        <button type="button" data-view="front">Front</button>
        <button type="button" data-view="side">Side</button>
        <button type="button" data-view="orbit" aria-pressed="false">Orbit</button>
      </div>
      <button class="speed" type="button" aria-label="Playback speed">1×</button>
      <button class="frames" type="button" aria-pressed="false" title="Show each link's coordinate frame">Frames</button>
      {recordable && <button class="save" type="button" title="Record one loop as a WebM video">Save video</button>}
    </div>
  )}
  <slot />
</figure>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  import { MeshoptDecoder } from "three/addons/libs/meshopt_decoder.module.js";
  import { toCreasedNormals } from "three/addons/utils/BufferGeometryUtils.js";

  type Recording = {
    duration: number;
    bpm: number;
    links: string[];
    states: string[];
    frames: number[][];
    choreography: string;
  };

  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  class Replay {
    root: HTMLElement;
    canvas: HTMLCanvasElement;
    renderer!: THREE.WebGLRenderer;
    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(32, 1, 0.05, 50);
    controls!: OrbitControls;
    groups: THREE.Group[] = [];
    rec!: Recording;
    times!: Float64Array;
    poses!: Float32Array[]; // per frame: 7 numbers per link
    t = 0;
    speed = 1;
    playing = !reducedMotion;
    visible = false;
    last = performance.now();
    pose = new Float32Array(7);
    orbit = false;

    constructor(root: HTMLElement) {
      this.root = root;
      this.canvas = root.querySelector("canvas")!;
    }

    status(text: string | null) {
      const box = this.root.querySelector<HTMLElement>(".status")!;
      box.textContent = text ?? "";
      box.hidden = text === null;
    }

    async start() {
      try {
        this.renderer = new THREE.WebGLRenderer({ canvas: this.canvas, antialias: true, preserveDrawingBuffer: false });
      } catch {
        this.status("This browser can't show 3D (WebGL is off).");
        return;
      }
      this.renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      this.renderer.shadowMap.enabled = true;
      this.renderer.shadowMap.type = THREE.PCFShadowMap;
      this.renderer.toneMapping = THREE.ACESFilmicToneMapping;
      this.buildStage();

      performance.mark("replay-fetch");
      const loader = new GLTFLoader().setMeshoptDecoder(MeshoptDecoder);
      const [gltf, rec] = await Promise.all([
        loader.loadAsync(this.root.dataset.model!),
        fetch(this.root.dataset.recording!).then((r) => {
          if (!r.ok) throw new Error(`recording: ${r.status}`);
          return r.json() as Promise<Recording>;
        }),
      ]).catch((error) => {
        this.status(`Couldn't load the replay (${error.message}).`);
        throw error;
      });
      performance.measure("replay: download + decode", "replay-fetch");
      performance.mark("replay-prepare");
      this.rec = rec;
      this.times = Float64Array.from(rec.frames, (f) => f[0]);
      this.poses = rec.frames.map((f) => Float32Array.from(f.slice(2)));

      for (const name of rec.links) {
        const group = new THREE.Group();
        group.matrixAutoUpdate = false;
        const node = gltf.scene.getObjectByName(name);
        if (node) {
          node.traverse((child) => {
            const mesh = child as THREE.Mesh;
            if (!mesh.isMesh) return;
            mesh.geometry = toCreasedNormals(mesh.geometry, Math.PI / 5);
            const material = mesh.material as THREE.MeshStandardMaterial;
            material.flatShading = false;
            material.needsUpdate = true;
            mesh.castShadow = true;
            mesh.receiveShadow = true;
          });
          group.add(node);
        }
        const axes = new THREE.AxesHelper(0.06);
        axes.visible = false;
        axes.name = "frame";
        group.add(axes);
        this.scene.add(group);
        this.groups.push(group);
      }
      performance.measure("replay: build scene", "replay-prepare");
      this.status(null);
      this.view("front");
      this.bind();
      this.apply(0);
      this.renderer.setAnimationLoop(() => this.frame());
    }

    buildStage() {
      this.scene.background = new THREE.Color(0x10151d);
      this.camera.up.set(0, 0, 1); // URDF and /xform_world are z-up
      this.scene.add(new THREE.HemisphereLight(0xe8eefc, 0x262b33, 1.3));
      const key = new THREE.DirectionalLight(0xffffff, 2.2);
      key.position.set(2.5, -1.5, 4);
      key.castShadow = true;
      key.shadow.mapSize.set(1024, 1024);
      Object.assign(key.shadow.camera, { left: -1.2, right: 1.2, top: 1.2, bottom: -1.2, near: 0.5, far: 10 });
      key.shadow.bias = -0.0005;
      this.scene.add(key);
      const rim = new THREE.DirectionalLight(0xffcb05, 0.6);
      rim.position.set(-3, 2, 2);
      this.scene.add(rim);

      const floor = new THREE.Mesh(
        new THREE.CircleGeometry(3, 64),
        new THREE.MeshStandardMaterial({ color: 0x161d28, roughness: 0.95 }),
      );
      floor.receiveShadow = true;
      this.scene.add(floor);
      const grid = new THREE.PolarGridHelper(2.8, 12, 10, 64, 0x2c3646, 0x222b38);
      grid.rotation.x = Math.PI / 2;
      grid.position.z = 0.001;
      this.scene.add(grid);

      this.controls = new OrbitControls(this.camera, this.canvas);
      this.controls.enableDamping = true;
      this.controls.maxPolarAngle = Math.PI / 2 - 0.05; // stay above the floor
      this.controls.minDistance = 0.8;
      this.controls.maxDistance = 6;
      this.controls.enablePan = false;
      this.controls.target.set(0, -0.04, 0.62);
    }

    view(name: string) {
      const target = this.controls.target;
      const distance = this.root.dataset.compact ? 2.75 : 2.7;
      const directions: Record<string, [number, number, number]> = {
        front: [1, -0.32, 0.18],
        side: [0.1, -1, 0.15],
      };
      if (name === "orbit") {
        this.orbit = !this.orbit;
        this.controls.autoRotate = this.orbit;
        this.controls.autoRotateSpeed = 1.2;
        this.root.querySelector('[data-view="orbit"]')?.setAttribute("aria-pressed", String(this.orbit));
        return;
      }
      const d = new THREE.Vector3(...directions[name]).normalize().multiplyScalar(distance);
      this.camera.position.copy(target).add(d);
      this.controls.update();
    }

    bind() {
      const q = <T extends Element>(s: string) => this.root.querySelector<T>(s);
      const play = q<HTMLButtonElement>(".play");
      const sync = () => {
        if (!play) return;
        play.textContent = this.playing ? "❚❚" : "▶";
        play.setAttribute("aria-label", this.playing ? "Pause" : "Play");
      };
      sync();
      play?.addEventListener("click", () => {
        this.playing = !this.playing;
        sync();
      });
      const scrub = q<HTMLInputElement>(".scrub");
      scrub?.addEventListener("input", () => {
        this.t = (Number(scrub.value) / 1000) * this.rec.duration;
        this.apply(this.t);
      });
      this.root.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) =>
        button.addEventListener("click", () => this.view(button.dataset.view!)),
      );
      const speed = q<HTMLButtonElement>(".speed");
      speed?.addEventListener("click", () => {
        this.speed = this.speed === 1 ? 0.5 : this.speed === 0.5 ? 0.25 : 1;
        speed.textContent = `${this.speed}×`;
      });
      const frames = q<HTMLButtonElement>(".frames");
      frames?.addEventListener("click", () => {
        const on = frames.getAttribute("aria-pressed") !== "true";
        frames.setAttribute("aria-pressed", String(on));
        for (const group of this.groups) group.getObjectByName("frame")!.visible = on;
      });
      q<HTMLButtonElement>(".save")?.addEventListener("click", (event) => this.saveVideo(event.currentTarget as HTMLButtonElement));
      // Compact (hero) replays toggle with a click on the stage.
      if (this.root.dataset.compact) {
        this.canvas.addEventListener("dblclick", () => (this.playing = !this.playing));
      }
    }

    // Pose every link at loop time t by blending the two recorded frames around it.
    apply(t: number) {
      const { times, poses } = this;
      let hi = times.findIndex((time) => time > t);
      if (hi <= 0) hi = Math.max(1, hi === 0 ? 1 : times.length - 1);
      const lo = hi - 1;
      const span = times[hi] - times[lo];
      const alpha = span > 0 ? Math.min(1, Math.max(0, (t - times[lo]) / span)) : 0;
      const a = poses[lo];
      const b = poses[hi];
      const position = new THREE.Vector3();
      const rotation = new THREE.Quaternion();
      const one = new THREE.Vector3(1, 1, 1);
      for (let i = 0; i < this.groups.length; i += 1) {
        const o = i * 7;
        position.set(
          a[o] + (b[o] - a[o]) * alpha,
          a[o + 1] + (b[o + 1] - a[o + 1]) * alpha,
          a[o + 2] + (b[o + 2] - a[o + 2]) * alpha,
        );
        THREE.Quaternion.slerpFlat(this.pose, 0, a, o + 3, b, o + 3, alpha);
        rotation.fromArray(this.pose);
        this.groups[i].matrix.compose(position, rotation, one);
        this.groups[i].matrixWorldNeedsUpdate = true;
      }
      const state = this.rec.states[this.rec.frames[alpha < 0.5 ? lo : hi][1]];
      const move = this.root.querySelector<HTMLElement>(".move-name");
      if (move && state) move.textContent = state.replace(/_/g, " ");
      const beat = 60 / this.rec.bpm;
      const phase = ((t % beat) + beat) % beat / beat;
      this.root.querySelector<HTMLElement>(".beat")?.style.setProperty("opacity", String(Math.max(0.15, 1 - phase * 2.2)));
    }

    frame() {
      const now = performance.now();
      const dt = Math.min(0.1, (now - this.last) / 1000);
      this.last = now;
      if (!this.visible && !this.recorder) return;
      if (this.playing) {
        this.t = (this.t + dt * this.speed) % this.rec.duration;
        this.apply(this.t);
        const scrub = this.root.querySelector<HTMLInputElement>(".scrub");
        if (scrub) scrub.value = String(Math.round((this.t / this.rec.duration) * 1000));
        const time = this.root.querySelector<HTMLElement>(".time");
        if (time) time.textContent = `${this.t.toFixed(1)} s`;
      }
      this.resize();
      this.controls.update();
      this.renderer.render(this.scene, this.camera);
    }

    resize() {
      const { clientWidth: w, clientHeight: h } = this.canvas;
      if (this.canvas.width !== Math.round(w * this.renderer.getPixelRatio()) || this.camera.aspect !== w / h) {
        this.renderer.setSize(w, h, false);
        this.camera.aspect = w / h;
        this.camera.updateProjectionMatrix();
      }
    }

    recorder: MediaRecorder | null = null;

    // Record exactly one loop, from its start, as a WebM file.
    saveVideo(button: HTMLButtonElement) {
      if (this.recorder || typeof MediaRecorder === "undefined") return;
      const type = ["video/webm;codecs=vp9", "video/webm"].find((t) => MediaRecorder.isTypeSupported(t));
      if (!type) {
        button.textContent = "Not supported here";
        return;
      }
      const chunks: Blob[] = [];
      const stream = this.canvas.captureStream(60);
      this.recorder = new MediaRecorder(stream, { mimeType: type, videoBitsPerSecond: 8_000_000 });
      this.recorder.ondataavailable = (event) => chunks.push(event.data);
      this.recorder.onstop = () => {
        const link = document.createElement("a");
        link.href = URL.createObjectURL(new Blob(chunks, { type: "video/webm" }));
        link.download = `${this.rec.choreography}.webm`;
        link.click();
        this.recorder = null;
        button.textContent = "Save video";
        button.disabled = false;
      };
      this.t = 0;
      this.speed = 1;
      this.playing = true;
      button.disabled = true;
      button.textContent = "Recording one loop…";
      this.recorder.start();
      setTimeout(() => this.recorder?.stop(), this.rec.duration * 1000);
    }
  }

  for (const root of document.querySelectorAll<HTMLElement>(".replay")) {
    const replay = new Replay(root);
    let started = false;
    new IntersectionObserver(
      ([entry]) => {
        replay.visible = entry.isIntersecting;
        if (entry.isIntersecting && !started) {
          started = true;
          replay.start().catch((error) => console.error(error));
        }
      },
      { rootMargin: "200px" },
    ).observe(root);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) replay.visible = false;
    });
  }
</script>

<style>
  .replay {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--stage);
    border: 1px solid var(--line);
    color: #e7eaf0;
  }
  .stage {
    position: relative;
    aspect-ratio: 16 / 10;
    max-height: 72vh;
    width: 100%;
  }
  .compact .stage {
    aspect-ratio: 4 / 5;
    max-height: 78vh;
  }
  @media (max-width: 720px) {
    .compact .stage {
      aspect-ratio: 1 / 1;
    }
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: grab;
  }
  .status {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #8d97a8;
    font-size: 0.9rem;
    pointer-events: none;
  }
  .status[hidden] {
    display: none;
  }
  .move {
    position: absolute;
    left: 12px;
    top: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    font: 600 0.78rem/1 var(--mono);
    letter-spacing: 0.02em;
    color: #c9d1dd;
    pointer-events: none;
  }
  .beat {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ffcb05;
    opacity: 0.15;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    background: #0b0f15;
    border-top: 1px solid #222b38;
    font-size: 0.85rem;
  }
  .bar button {
    font: 600 0.8rem/1 var(--font);
    color: #e7eaf0;
    background: #1b2330;
    border: 1px solid #2c3646;
    border-radius: 8px;
    padding: 7px 10px;
    cursor: pointer;
    min-height: 32px;
  }
  .bar button:hover {
    border-color: #8d97a8;
  }
  .bar button[aria-pressed="true"] {
    background: #ffcb05;
    color: #0c1016;
    border-color: #ffcb05;
  }
  .bar button:disabled {
    opacity: 0.7;
    cursor: progress;
  }
  .play {
    width: 40px;
  }
  .scrub {
    flex: 1 1 160px;
    accent-color: #ffcb05;
    min-width: 120px;
  }
  .time {
    font-family: var(--mono);
    color: #8d97a8;
    width: 4.2em;
    text-align: right;
  }
  .group {
    display: flex;
    gap: 4px;
  }
</style>
