---
import Base from "../layouts/Base.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { site } from "../site";
import { url } from "../lib/url";
import { projects } from "../lib/projects";

// Finished projects only, featured first; everything else is on the Projects page.
const shown = (await projects())
  .filter((p) => p.data.status === "published")
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order);
const { links } = site;
---

<Base>
  <section class="wrap hero">
    <p class="eyebrow">Robotics · Dynamics · Control</p>
    <h1>{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <div class="links">
      {links.github && <a class="button" href={links.github}>GitHub</a>}
      {links.linkedin && <a class="button" href={links.linkedin}>LinkedIn</a>}
      {links.cv && <a class="button" href={url(links.cv)}>CV</a>}
      <a class="about" href={url("about/")}>About me →</a>
    </div>
  </section>

  <section class="wrap" aria-labelledby="projects">
    <h2 id="projects" class="visually-hidden">Projects</h2>
    <div class="rows">
      {shown.map((project) => <ProjectRow project={project} />)}
    </div>
    <p class="more"><a href={url("projects/")}>All projects and what’s next →</a></p>
  </section>
</Base>

<style>
  .hero {
    padding-top: 48px;
    padding-bottom: 36px;
  }
  @media (min-width: 900px) {
    .hero {
      padding-top: 72px;
      padding-bottom: 56px;
    }
  }
  h1 {
    margin-bottom: 0.25em;
  }
  .tagline {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    line-height: 1.4;
    margin-bottom: 18px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }
  .about {
    font-weight: 650;
    font-size: 0.92rem;
    color: var(--highlight);
    text-decoration: none;
  }
  .about:hover {
    text-decoration: underline;
  }
  .rows {
    display: grid;
    gap: 56px;
  }
  @media (min-width: 860px) {
    .rows {
      gap: 88px;
    }
  }
  .more {
    margin-top: 56px;
    font-weight: 650;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
